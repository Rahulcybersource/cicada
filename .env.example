# =============================================================================
# CICADA 2026 - End-to-End Secure AIOps Observability Platform
# Environment Configuration Template
# =============================================================================

# Hybrid AIOps LLM API Keys (Groq = Primary, Gemini = Secondary fallback)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Configuration
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=4.0

# Tier 2 SaaS Configuration (Port 8000)
TIER2_HOST=0.0.0.0
TIER2_PORT=8000
DATABASE_URL=sqlite:///./tier2_saas.db

# Tier 1 Collector Configuration (Port 8001 / 8002)
TIER1_HOST=0.0.0.0
TIER1_PORT=8001
COLLECTOR_AUTH_TOKEN=collector-token-demo
COLLECTOR_TOKEN=collector-token-demo
LOCAL_ENCRYPTION_KEY=
TIER1_ENCRYPTION_KEY=
PSEUDONYM_SALT=tenant_acme_corp_salt_2024
TENANT_SALT=tenant_acme_corp_salt_2024

# Frontend Control Plane (Port 3000)
NEXT_PUBLIC_TIER2_URL=http://localhost:8000
NEXT_PUBLIC_TIER1_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8000
